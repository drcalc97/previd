# Copy to .env.local (never commit real values). See DEPLOYMENT.md.
APP_URL=http://localhost:3000

# Database. DATABASE_URL = restricted app role (RLS applies). DATABASE_ADMIN_URL = owner, used ONLY by scripts/db.ts.
DATABASE_URL=postgres://previd_app:CHANGE_ME_APP_PW@localhost:5432/previd_dev
DATABASE_ADMIN_URL=postgres://previd_owner:CHANGE_ME_OWNER_PW@localhost:5432/previd_dev
DATABASE_APP_PASSWORD=CHANGE_ME_APP_PW
# TLS to Postgres: defaults to 'require' in production; 'disable' only for local servers.
DATABASE_SSL=disable

# Providers: local (development/test ONLY) | supabase
AUTH_PROVIDER=local
STORAGE_PROVIDER=local
# Must be "true" to run local providers when NODE_ENV=production. Never set in a real deployment.
PREVID_ALLOW_DEV_ADAPTERS=false

# Secrets (generate: openssl rand -base64 32)
SIGNING_SECRET=
AUTH_ENC_KEY=
CRON_SECRET=
LOCAL_STORAGE_DIR=.data/videos

# Supabase (only when AUTH_PROVIDER/STORAGE_PROVIDER=supabase). The service-role key is SERVER ONLY.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VIDEO_BUCKET=videos
